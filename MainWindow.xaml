<Window x:Class="RnxCAD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:RnxCAD"
        Title="RnxCAD" Width="1440" Height="900" MinWidth="990" MinHeight="650" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource Shell}" Foreground="{StaticResource Ink}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="50" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/><RowDefinition Height="79"/><RowDefinition Height="*"/><RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Paper}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="13,1,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Width="32" Height="32" Background="#1D2B2E" CornerRadius="7" Margin="2,0,9,0">
                        <Viewbox Width="20" Height="20">
                            <Path Stroke="{StaticResource Accent}" StrokeThickness="1.55" StrokeLineJoin="Round" Data="M 2,17 L 2,3 L 11,3 L 16,8 L 11,13 L 7,13 M 8,8 L 16,17 M 2,17 L 5,17"/>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="RnxCAD" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,18,1"/>
                    <Border Background="{StaticResource Border}" Width="1" Height="23" Margin="0,0,10,0"/>
                    <Button x:Name="FileMenu" Content="Файл" Height="32" Click="FileMenu_Click"/>
                    <Button x:Name="EditMenu" Content="Правка" Height="32" Click="EditMenu_Click"/>
                    <Button x:Name="ViewMenu" Content="Вид" Height="32" Click="ViewMenu_Click"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#F2F4EE" BorderBrush="{StaticResource Border}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="5" Padding="10,6" MaxWidth="330">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl x:Name="TitleIcon" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DrawingTitle" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="225" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DirtyMark" Text="●" FontSize="8" Foreground="#56711C" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="QuickOpen" Style="{StaticResource SmallButton}" Click="Open_Click"/>
                    <Button x:Name="QuickSave" Style="{StaticResource SmallButton}" Click="Save_Click" Margin="1,0"/>
                    <Border Background="{StaticResource Border}" Width="1" Height="20" Margin="7,0"/>
                    <Button x:Name="QuickUndo" Style="{StaticResource SmallButton}" Click="Undo_Click"/>
                    <Button x:Name="QuickRedo" Style="{StaticResource SmallButton}" Click="Redo_Click"/>
                    <Button x:Name="ExportButton" Height="32" Margin="10,0,11,0" Padding="10,3" Background="{StaticResource Accent}" BorderBrush="#C9E377" Click="Export_Click"/>
                    <Border Background="{StaticResource Border}" Width="1" Height="22" Margin="0,0,5,0"/>
                    <Button x:Name="MinButton" Style="{StaticResource FrameButton}" Click="Minimize_Click"/>
                    <Button x:Name="MaxButton" Style="{StaticResource FrameButton}" Click="Maximize_Click"/>
                    <Button x:Name="CloseButton" Style="{StaticResource FrameButton}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource Shell}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="16,7,16,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="РИСОВАНИЕ" Style="{StaticResource Caption}" Margin="4,0,0,4"/>
                    <StackPanel x:Name="DrawTools" Orientation="Horizontal"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Width="1" Background="{StaticResource Border}" Margin="12,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="РЕДАКТИРОВАНИЕ" Style="{StaticResource Caption}" Margin="4,0,0,4"/>
                        <StackPanel x:Name="EditTools" Orientation="Horizontal"/>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="HelpButton" Grid.Column="3" Style="{StaticResource SmallButton}" Width="32" Height="32" VerticalAlignment="Center" Click="Help_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="51"/><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource Shell}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <Grid Margin="0,9,0,8">
                    <StackPanel x:Name="RailTools" HorizontalAlignment="Center"/>
                    <Button x:Name="CommandFocus" Style="{StaticResource RailButton}" VerticalAlignment="Bottom" Click="CommandFocus_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="71"/></Grid.RowDefinitions>
                <local:CadSurface x:Name="Surface" Focusable="True" ClipToBounds="True"/>
                <Border Grid.Row="1" Background="#F8F9F5" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                    <Grid Margin="11,7,11,8">
                        <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel LastChildFill="True">
                            <Button x:Name="HistoryButton" DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Height="20" Width="25" Click="History_Click" Margin="4,-2,0,0"/>
                            <TextBlock x:Name="PromptText" FontSize="11" Foreground="{StaticResource Muted}" Margin="3,1,0,0" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <Border Grid.Row="1" Background="{StaticResource Paper}" BorderBrush="#D9DED4" BorderThickness="1" CornerRadius="5">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left" Text="›_" Foreground="#506347" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="14" Margin="9,0,9,1" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" x:Name="EnterHint" Text="ENTER" FontFamily="{StaticResource MonoFont}" Foreground="#667268" FontSize="10" Margin="8,0,9,0" VerticalAlignment="Center"/>
                                <Grid>
                                    <TextBlock x:Name="CommandHint" Text="Введите команду или координаты" Foreground="#677067" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <TextBox x:Name="CommandBox" AutomationProperties.Name="Командная строка" TextChanged="Command_TextChanged" KeyDown="Command_KeyDown" Padding="0" FocusVisualStyle="{x:Null}" IsUndoEnabled="False" Background="Transparent" BorderThickness="0" FontSize="12" VerticalContentAlignment="Center" FontFamily="{StaticResource MonoFont}"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2" Background="{StaticResource Paper}" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <Grid Margin="15,14,13,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentControl x:Name="LayersIcon" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Слои" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="EditLayerButton" Grid.Column="1" Style="{StaticResource SmallButton}" Click="EditLayer_Click"/>
                            <Button x:Name="AddLayerButton" Grid.Column="2" Style="{StaticResource SmallButton}" Background="#EDF2E5" Click="AddLayer_Click" Margin="3,0,0,0"/>
                        </Grid>
                        <Grid Margin="17,0,16,4">
                            <TextBlock Text="ИМЯ" Style="{StaticResource Caption}"/>
                            <TextBlock Text="ВИД  /  БЛОК" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                        </Grid>
                        <StackPanel x:Name="LayerRows" Margin="9,0,9,6"/>

                        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,1" Background="#F5F7F1" Padding="15,9" Margin="0,3,0,0">
                            <DockPanel>
                                <TextBlock x:Name="LayerCount" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11"/>
                                <TextBlock x:Name="ActiveLayerText" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,7,0"/>
                            </DockPanel>
                        </Border>

                        <StackPanel Margin="15,15,15,13">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ContentControl x:Name="PropertiesIcon" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Свойства" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border x:Name="ObjectCard" Background="#F2F4EE" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="5" Padding="9,8" Margin="0,0,0,11">
                                <DockPanel LastChildFill="True">
                                    <ContentControl x:Name="SelectionIcon" DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ObjectType" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>
                            <StackPanel x:Name="PropertyRows"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource Shell}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Grid Margin="13,0,13,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#DFE6D7" CornerRadius="4" Padding="8,4" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl x:Name="ModelIcon" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Модель" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="CoordinateText" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="GridButton" Content="Сетка" Style="{StaticResource FlagButton}" IsChecked="True" Click="Options_Click" ToolTip="Показать или скрыть сетку (F7)"/>
                    <ToggleButton x:Name="OrthoButton" Content="Орто" Style="{StaticResource FlagButton}" Click="Options_Click" ToolTip="Ортогональное построение (F8)"/>
                    <ToggleButton x:Name="SnapButton" Content="Привязка" Style="{StaticResource FlagButton}" IsChecked="True" Click="Options_Click" ToolTip="Конец, середина и центр (F3)"/>
                    <Border Width="1" Height="16" Background="{StaticResource Border}" Margin="11,0,11,0"/>
                    <TextBlock x:Name="UnitText" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
